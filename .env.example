# ============ 数据库 ============
# 三选一（默认 SQLite，POC 零配置即可跑；生产指向 PostgreSQL/MySQL 数仓）
DATABASE_URL=sqlite:///./data/business.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/biz
# DATABASE_URL=mysql://user:pass@localhost:3306/biz

# ============ 语义注册表 / 审计 ============
REGISTRY_PATH=./data/registry.yaml
AUDIT_LOG_PATH=./data/audit.log

# ============ 可选 LLM（未注册指标候选 SQL） ============
# 不配置时仅支持「已注册指标」的确定性查询，未注册指标会被安全拦截
LLM_ENABLED=false
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=

# ============ 服务 ============
HOST=0.0.0.0
PORT=8000
